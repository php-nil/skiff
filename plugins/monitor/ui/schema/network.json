{
  "version": 1,
  "data": {
    "network": {
      "method": "network",
      "params": { "protocol": "all", "state": "all", "all": true }
    }
  },
  "page": {
    "type": "page",
    "props": {
      "title": "主机监控 · 网络",
      "subtitle": "只读解析 /proc/net/tcp、tcp6、udp、udp6；插件降权运行，无法把套接字可靠映射到 PID"
    },
    "body": [
      {
        "type": "flex",
        "props": { "gap": 8, "wrap": true },
        "content": {
          "body": [
            {
              "type": "button",
              "props": { "text": "刷新", "variant": "text" },
              "onEvent": {
                "click": {
                  "actions": [
                    { "type": "skiffPluginView", "props": { "view": "network" } }
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "type": "text",
        "props": {
          "text": "{{data.network.owner_note}}；表头筛选框可搜索地址、状态与 uid。"
        }
      },
      {
        "type": "card",
        "props": { "title": "连接列表" },
        "content": {
          "body": [
            {
              "type": "table",
              "props": {
                "items": "{{data.network.items}}",
                "rowKey": "key",
                "pagination": true,
                "perPage": 50,
                "perPageOptions": [25, 50, 100, 200],
                "density": "compact",
                "emptyText": "没有匹配的连接",
                "filters": {
                  "local": "text",
                  "remote": "text",
                  "state": "text",
                  "uid": "text"
                },
                "columns": [
                  { "key": "protocol_text", "label": "协议" },
                  { "key": "local", "label": "本地地址" },
                  { "key": "remote", "label": "对端地址" },
                  { "key": "state", "label": "状态" },
                  { "key": "uid", "label": "所属进程（uid）", "type": "number", "align": "end" },
                  { "key": "inode", "label": "inode", "type": "number", "align": "end" }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
