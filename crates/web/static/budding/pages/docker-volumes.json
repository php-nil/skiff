{
  "type": "page",
  "source": { "url": "/ui/v1/volumes", "params": { "limit": 1 } },
  "props": {
    "title": "卷",
    "subtitle": "${data && data.can_admin ? '创建与删除走 /ui/v1' : '只读列表；写操作需要管理员权限'}"
  },
  "body": [
    {
      "type": "alert",
      "props": {
        "type": "warning",
        "title": "Docker 不可用",
        "text": "${(data && data.docker_reason) || 'Docker 守护进程当前不可达，列表为空。'}"
      },
      "visibleOn": "${!!data && !data.docker_available}"
    },
    {
      "type": "table",
      "id": "docker-volumes-table",
      "source": { "url": "/ui/v1/volumes", "params": {} },
      "props": {
        "columns": [
          { "key": "name", "label": "名称" },
          { "key": "meta", "label": "驱动与挂载点" },
          { "key": "warn", "label": "提示" }
        ],
        "rowKey": "id",
        "pagination": false,
        "perPage": -1,
        "density": "compact",
        "paging": "cursor",
        "cursorParam": "cursor",
        "itemsPath": "data.items",
        "totalPath": "data.total",
        "cursorPath": "data.next_cursor",
        "loadMoreText": "加载更多",
        "emptyText": "${!(data && data.docker_available) ? 'Docker 不可用，卷列表为空' : '还没有命名卷，创建后可在新建容器时挂载'}",
        "rowActions": [
          {
            "type": "button",
            "props": { "text": "删除", "variant": "text", "color": "danger" },
            "visibleOn": "${!!(data && data.can_admin)}",
            "onEvent": {
              "click": {
                "actions": [
                  {
                    "type": "confirm",
                    "props": {
                      "title": "删除卷",
                      "content": "确认删除 ${name}？此操作不可撤销。"
                    }
                  },
                  {
                    "type": "ajax",
                    "props": {
                      "api": { "method": "POST", "url": "/ui/v1/volumes/${id}/remove" },
                      "messages": { "success": "已删除" }
                    }
                  },
                  {
                    "type": "invoke",
                    "props": { "component": "docker-volumes-table", "command": "reload" }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "type": "card",
      "props": { "title": "创建卷" },
      "visibleOn": "${!!(data && data.can_admin)}",
      "content": {
        "body": [
          { "type": "text", "props": { "text": "名称只允许字母数字与 _-." } },
          {
            "type": "form",
            "props": {
              "api": { "method": "POST", "url": "/ui/v1/volumes" },
              "actionsAlign": "end",
              "successMessage": "已创建",
              "onSuccess": [
                {
                  "type": "invoke",
                  "props": { "component": "docker-volumes-table", "command": "reload" }
                }
              ]
            },
            "body": [
              {
                "type": "input-text",
                "props": {
                  "name": "name",
                  "label": "卷名",
                  "required": true,
                  "rules": { "required": true, "messages": { "required": "请输入名称" } }
                }
              }
            ],
            "content": {
              "actions": [
                {
                  "type": "button",
                  "props": { "text": "创建", "color": "primary" },
                  "action": { "type": "submit" }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
