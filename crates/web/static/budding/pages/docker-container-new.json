{
  "type": "page",
  "props": { "title": "新建容器", "subtitle": "提交后进入容器详情页" },
  "body": [
    {
      "type": "alert",
      "props": {
        "type": "info",
        "text": "端口、环境变量、绑定与卷均按每行一条；网络每行一个名称。留空表示不设置。"
      }
    },
    {
      "type": "form",
      "props": {
        "api": { "method": "POST", "url": "/ui/v1/containers", "sendOn": false },
        "actionsAlign": "end"
      },
      "onEvent": {
        "submit": [{ "type": "skiffDockerWrite", "props": { "op": "create" } }]
      },
      "body": [
        {
          "type": "input-text",
          "props": {
            "name": "image",
            "label": "镜像（必填）",
            "required": true,
            "rules": { "required": true, "messages": { "required": "请输入镜像" } }
          }
        },
        { "type": "input-text", "props": { "name": "name", "label": "容器名（可选）" } },
        { "type": "textarea", "props": { "name": "ports", "label": "端口映射（host:container[/udp]，每行一条）", "rows": 3 } },
        { "type": "textarea", "props": { "name": "env", "label": "环境变量（KEY=VALUE，每行一条）", "rows": 3 } },
        { "type": "textarea", "props": { "name": "binds", "label": "宿主绑定（源:目标[:ro]，每行一条）", "rows": 3 } },
        { "type": "textarea", "props": { "name": "volumes", "label": "命名卷（卷名:目标[:ro]，每行一条）", "rows": 3 } },
        { "type": "input-text", "props": { "name": "restart", "label": "重启策略（如 unless-stopped）" } },
        { "type": "textarea", "props": { "name": "networks", "label": "网络（每行一个，可留空）", "rows": 3 } },
        { "type": "input-text", "props": { "name": "cpu_shares", "label": "CPU 份额" } },
        { "type": "input-text", "props": { "name": "cpu_period", "label": "CPU 周期（μs）" } },
        { "type": "input-text", "props": { "name": "cpu_quota", "label": "CPU 配额（μs）" } },
        { "type": "input-text", "props": { "name": "memory_limit_mb", "label": "内存上限（MB）" } },
        { "type": "input-text", "props": { "name": "memory_swap_mb", "label": "内存+交换（MB）" } },
        { "type": "input-text", "props": { "name": "pids_limit", "label": "PIDs 上限" } }
      ],
      "content": {
        "actions": [
          {
            "type": "button",
            "props": { "text": "创建容器", "color": "primary" },
            "action": { "type": "submit" }
          }
        ]
      }
    }
  ]
}
