{
  "type": "page",
  "source": { "url": "/ui/v1/networks", "params": { "limit": 1 } },
  "props": {
    "title": "网络",
    "subtitle": "${data && data.can_admin ? '创建与删除走 /ui/v1' : '只读列表；写操作需要管理员权限'}"
  },
  "content": {
    "actions": [
      {
        "type": "button",
        "props": { "text": "创建网络", "variant": "tonal", "color": "primary" },
        "visibleOn": "${!!(data && data.can_admin)}",
        "action": {
          "type": "dialog",
          "props": { "title": "创建网络", "width": 480 },
          "content": {
            "body": [
              {
                "type": "form",
                "props": {
                  "api": { "method": "POST", "url": "/ui/v1/networks" },
                  "successMessage": "已创建",
                  "onSuccess": [
                    {
                      "type": "invoke",
                      "props": { "component": "docker-networks-table", "command": "reload" }
                    },
                    { "type": "close" }
                  ]
                },
                "body": [
                  {
                    "type": "input-text",
                    "props": {
                      "name": "name",
                      "label": "网络名",
                      "hint": "名称只允许字母、数字与 _-.",
                      "required": true,
                      "rules": { "required": true, "messages": { "required": "请输入名称" } }
                    }
                  }
                ]
              }
            ],
            "footer": [
              { "type": "button", "props": { "text": "重置", "variant": "text" }, "action": { "type": "reset" } },
              { "type": "button", "props": { "text": "取消", "variant": "outlined" }, "action": { "type": "close" } },
              { "type": "button", "props": { "text": "创建", "color": "primary" }, "action": { "type": "submit" } }
            ]
          }
        }
      }
    ]
  },
  "body": [
    {
      "type": "alert",
      "props": {
        "type": "warning",
        "title": "Docker 不可用",
        "text": "${(data && data.docker_reason) || 'Docker 守护进程当前不可达，列表为空。'}"
      },
      "visibleOn": "${!!data && !data.docker_available}"
    },
    {
      "type": "table",
      "id": "docker-networks-table",
      "source": { "url": "/ui/v1/networks", "params": {} },
      "props": {
        "columns": [
          { "key": "name", "label": "名称" },
          { "key": "driver", "label": "驱动" },
          { "key": "scope", "label": "范围" },
          { "key": "subnet", "label": "子网" },
          { "key": "gateway", "label": "网关" },
          { "key": "container_count", "label": "容器" },
          { "key": "internal", "label": "内部/外部" }
        ],
        "rowKey": "id",
        "pagination": false,
        "perPage": -1,
        "density": "compact",
        "paging": "cursor",
        "cursorParam": "cursor",
        "itemsPath": "data.items",
        "totalPath": "data.total",
        "cursorPath": "data.next_cursor",
        "loadMoreText": "加载更多",
        "emptyText": "${!(data && data.docker_available) ? 'Docker 不可用，网络列表为空' : '还没有自定义网络，需要隔离或固定子网时创建'}",
        "rowActions": [
          {
            "type": "button",
            "props": { "text": "删除", "variant": "text", "color": "danger" },
            "visibleOn": "${!!(data && data.can_admin) && !!can_remove}",
            "onEvent": {
              "click": {
                "actions": [
                  {
                    "type": "confirm",
                    "props": {
                      "title": "删除网络",
                      "content": "确认删除 ${name}？此操作不可撤销。"
                    }
                  },
                  {
                    "type": "request",
                    "props": {
                      "api": { "method": "POST", "url": "/ui/v1/networks/${id}/remove" },
                      "messages": { "success": "已删除" }
                    }
                  },
                  {
                    "type": "invoke",
                    "props": { "component": "docker-networks-table", "command": "reload" }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
