{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skiff.example/schema/app.schema.json",
  "title": "Docker 应用模板条目（skiff.server.app/v1）",
  "description": "compose 文件同样走内容寻址；compose 字段子集仍由既有 xtask 校验负责，此处只描述清单元数据。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "summary", "min_kernel", "images", "env", "ports", "volumes"],
  "properties": {
    "id": { "type": "string", "minLength": 4, "maxLength": 128 },
    "version": { "type": "string", "minLength": 5, "maxLength": 64 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "min_kernel": { "type": "string", "minLength": 5, "maxLength": 64 },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "digest"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
          "digest": { "type": "string", "minLength": 71, "maxLength": 71 }
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["container", "protocol"],
        "properties": {
          "container": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "enum": ["tcp", "udp"] }
        }
      }
    },
    "volumes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "compose_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "compose_url": { "type": "string", "minLength": 1, "maxLength": 512 },
    "size": { "type": "integer", "minimum": 0 },
    "asset": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
