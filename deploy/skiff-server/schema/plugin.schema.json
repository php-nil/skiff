{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skiff.example/schema/plugin.schema.json",
  "title": "插件条目（skiff.server.plugin/v1）",
  "description": "asset 为源数据字段，仅用于从本地文件派生摘要；产物索引中不出现 asset，而必须出现 pkg_sha256/pkg_url/size。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "api", "channel", "key_id", "summary", "published_at", "yanked"],
  "properties": {
    "id": { "type": "string", "minLength": 4, "maxLength": 128 },
    "version": { "type": "string", "minLength": 5, "maxLength": 64 },
    "api": { "type": "string", "minLength": 3, "maxLength": 16 },
    "channel": { "enum": ["stable", "night"] },
    "key_id": { "type": "string", "minLength": 64, "maxLength": 64 },
    "requires": {
      "type": "array",
      "items": { "enum": ["docker", "identity", "fs", "net", "interop", "scheduler", "ftp", "firewall"] }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "published_at": { "type": "string", "minLength": 20, "maxLength": 20 },
    "yanked": { "type": "boolean" },
    "pkg_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "pkg_url": { "type": "string", "minLength": 1, "maxLength": 512 },
    "size": { "type": "integer", "minimum": 0 },
    "asset": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
