{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skiff.example/schema/upgrade.schema.json",
  "title": "内核升级条目（skiff.server.upgrade/v1）",
  "description": "升级包按架构分条；签名锚在渠道 manifest，包本身不再单独签名（与发布物去签名口径一致）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "arch", "channel", "min_from", "changelog_url"],
  "properties": {
    "version": { "type": "string", "minLength": 5, "maxLength": 64 },
    "arch": { "enum": ["x86_64", "aarch64"] },
    "channel": { "enum": ["stable", "night"] },
    "min_from": { "type": "string", "minLength": 5, "maxLength": 64 },
    "changelog_url": { "type": "string", "minLength": 8, "maxLength": 512 },
    "pkg_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "pkg_url": { "type": "string", "minLength": 1, "maxLength": 512 },
    "size": { "type": "integer", "minimum": 0 },
    "asset": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
