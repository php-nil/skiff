{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skiff.example/schema/index.schema.json",
  "title": "渠道索引（skiff.server.index/v1）",
  "description": "每渠道一份全量索引；条目数组由生成器按稳定顺序输出。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "seq", "generated_at", "plugins", "apps", "runtimes", "upgrades", "revoked"],
  "properties": {
    "schema": { "const": "skiff.server.index/v1" },
    "channel": { "enum": ["stable", "night"] },
    "seq": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "minLength": 20, "maxLength": 20 },
    "plugins": { "type": "array", "items": { "$ref": "plugin.schema.json" } },
    "apps": { "type": "array", "items": { "$ref": "app.schema.json" } },
    "runtimes": { "type": "array", "items": { "$ref": "runtime.schema.json" } },
    "upgrades": { "type": "array", "items": { "$ref": "upgrade.schema.json" } },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "reason", "at"],
        "properties": {
          "id": { "type": "string", "minLength": 4, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
          "at": { "type": "string", "minLength": 20, "maxLength": 20 }
        }
      }
    },
    "revoked_apps": {
      "description": "应用模板的吊销命名空间；`revoked` 继续只表示插件。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "reason", "at"],
        "properties": {
          "id": { "type": "string", "minLength": 4, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
          "at": { "type": "string", "minLength": 20, "maxLength": 20 }
        }
      }
    },
    "revoked_runtimes": {
      "description": "运行环境的吊销命名空间；条目 id 即 kind（如 php），可比插件 id 短。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "reason", "at"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
          "at": { "type": "string", "minLength": 20, "maxLength": 20 }
        }
      }
    }
  }
}
