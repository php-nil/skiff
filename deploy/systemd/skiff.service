[Unit]
Description=Skiff (轻舟) — 极简 Linux 服务器管理面板
Documentation=https://github.com/example/skiff
After=network-online.target docker.service
Wants=network-online.target
# 不 Wants=docker.service：Docker 可以由用户后装，面板在无 Docker 时应能起来
# 并在 UI 中显示「Docker 不可用」（方案 §3.3 优雅降级）。

[Service]
Type=simple
User=root
# 主形态固定 root（方案 §5.1）：需要创建独立插件 UID/GID、访问 docker.sock、
# 后续 nftables/cgroups 操作。插件的降权由面板自身 setuid/gid 完成，不靠 unit。
Group=skiff-plugins
ExecStart=/usr/local/bin/skiff serve --config /etc/skiff/config.toml
Restart=always
RestartSec=3

# /run/skiff 由 systemd 创建，属组 skiff-plugins。
# 0711 而不是 0710：插件的主 gid 是自己的独立 gid，只靠「其他位」穿越目录；
# kernel.sock 本身是 0660 + 附加组 skiff-plugins，那才是真正的闸门。
RuntimeDirectory=skiff
RuntimeDirectoryMode=0711
# 刻意**不写** StateDirectory=skiff：systemd 会把 StateDirectory 按 User=/Group= chown，
# 于是 /www/skiff 变成 root:skiff-plugins，覆盖 install.sh 设的 root:root 0711，
# 和 DEPLOY_TEST.md §1.1 的权限口径对不上（2026-11-03 上机实测：装完 A6a/A6b/A6c 三条
# 权限断言全红，原因就在这里）。数据根由 install.sh 建并固定 0711 root:root；
# 运行目录 /run/skiff 仍由 systemd 建（tmpfs，重启即失，必须由它来建）。

# 面板要写 /www（库、站点、vhost、日志、证书、PHP socket）与 /run/skiff；
# ProtectSystem=full 只把 /usr、/boot、/etc 置只读，这里显式列白名单便于审计。
# /etc/docker：面板需要把镜像源写进 daemon.json（写前备份、失败回滚）。
ReadWritePaths=/www /run/skiff /etc/docker

# 插件 Supervisor 需要在自己的 cgroup 下放子进程；delegate 让容器/沙箱后续可控。
# 注：cgroups v2 限额在 MVP 未实现（见 docs/sections/12-pending-tests.md）。
Delegate=yes

# 停服时先 SIGTERM 主进程，由面板自己停插件；超时再 SIGKILL 整组。
KillMode=mixed
TimeoutStopSec=20
LimitNOFILE=65535

# 基础加固：插件已被 setuid 降权，主进程不应再获得新特权。
NoNewPrivileges=yes
ProtectSystem=full
ProtectControlGroups=no
ProtectKernelTunables=no
PrivateTmp=no

[Install]
WantedBy=multi-user.target
